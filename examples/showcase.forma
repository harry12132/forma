# Forma Feature Atlas: every implemented language feature shown in one place.
site "Forma · Feature Atlas"
  theme
    background "#09090b"
    foreground "#fafafa"
    accent "#c6f36b"
    muted "#a1a1aa"
    font "Inter"
    token color lime "#c6f36b"
    token color sky "#7dd3fc"
    token color violet "#c4b5fd"
    token color surface "#111318"
    token radius card "22px"
    token radius pill "999px"
    token shadow soft "0 18px 60px #00000018"
    token font display "Inter"
    token size large "20px"
    accent "$lime"

  component FeatureCard
    prop heading "Reusable component"
    prop description "Defined once, reused with different content."
    card
      surface "glass"
      radius "$card"
      shadow "$soft"
      title "{heading}"
      text "{description}"

  page "/"
    state count = 0
    state status = "Ready"
    state showDetails = false
    state contactEmail = ""
    state wantsUpdates = false
    state contactMethod = "email"
    state messageText = ""

    nav
      logo "forma."
      link "Language" -> "#language"
      link "Design" -> "#design"
      link "Interactions" -> "#interactions"
      button "Jump to playground" -> "#playground"

    hero
      badge "FEATURE ATLAS · EARLY RELEASE"
      title "The whole language. On display."
      text "One living showcase of Forma's implemented syntax: layouts, reusable components, design tokens, glass materials, motion, interactions, reactive state, and forms."
      button "Explore every feature" -> "#language"
      button "See the playground" -> "#playground"
        variant "secondary"
        radius "$card"
      animation "fade-up"
        duration "800ms"
        delay "80ms"
        easing spring

    panel
      surface "liquid-glass"
      effect "aurora"
      hover "lift"
      animation "zoom"
        duration "700ms"
        easing spring
      badge "THE IDEA"
      title "Write the experience. Let Forma handle the browser."
      text "Forma source compiles to ordinary HTML and CSS, with a small browser runtime for supported interactions. No UI framework or third-party runtime dependency is required."
      row
        gap "12px"
        wrap true
        badge "Readable syntax"
        badge "Generated HTML + CSS"
        badge "Responsive layouts"
        badge "Reduced-motion support"

    panel
      title "01 / Language and page structure"
      text "These are the structural blocks used to describe a site, page, navigation, hero, content, and footer."
      divider
      grid
        columns 3
        gap "14px"
        card
          title "site"
          text "Names the website and owns theme, component definitions, and pages."
        card
          title "page"
          text "Defines the page content and path."
        card
          title "theme"
          text "Sets semantic colours, fonts, and named design tokens."
        card
          title "nav + logo"
          text "A branded navigation bar with links and actions."
        card
          title "hero"
          text "A headline, supporting copy, badges, actions, and entrance motion."
        card
          title "footer"
          text "A final content area for supporting details."
      stack
        gap "10px"
        text "Other text elements include title, text, badge, link, and button."
        text "Comments begin with #. Two spaces per indentation level are expected; tabs are not allowed."
        link "Jump to design tokens" -> "#design"

    panel
      title "02 / Layout primitives"
      text "These layout containers are part of the language, with explicit spacing and alignment controls."
      stack
        gap "14px"
        panel
          surface "soft"
          title "stack · vertical flow"
          text "Children flow vertically with a configurable gap and alignment."
          stack
            gap "8px"
            badge "First item"
            badge "Second item"
            badge "Third item"
        panel
          surface "soft"
          title "row · horizontal flow"
          text "Rows support gap, alignment, justification, and wrapping."
          row
            gap "10px"
            align center
            justify between
            wrap true
            badge "Left"
            badge "Middle"
            badge "Right"
        panel
          surface "soft"
          title "grid · responsive columns"
          text "This grid uses three columns on wider screens and collapses on small screens."
          grid
            columns 3
            gap "10px"
            card
              title "01"
              text "First cell"
            card
              title "02"
              text "Second cell"
            card
              title "03"
              text "Third cell"
        panel
          surface "soft"
          title "container · controlled width"
          text "A centred content container with a maximum width and horizontal padding."
          container
            max "720px"
            padding "20px"
            panel
              title "Contained content"
              text "The inner content stays centred and readable."
        panel
          surface "soft"
          title "spacer + divider"
          text "A spacer creates deliberate vertical room. A divider draws a horizontal separator."
          badge "Above the spacer"
          spacer "18px"
          divider
          spacer "18px"
          badge "Below the divider"

    panel
      title "03 / Reusable components"
      text "Component definitions accept properties, defaults, and typed values. Instances override defaults without duplicating the component structure."
      grid
        columns 2
        gap "14px"
        FeatureCard
          heading "One definition"
          description "A reusable card gets its content through named properties."
        FeatureCard
          heading "Different content"
          description "This is the same component with different property values."
      card
        surface "soft"
        title "Property validation"
        text "String, number, and boolean properties are supported. Unknown, repeated, missing required, incorrectly typed, and recursive component calls are rejected by the compiler."
      text "Property interpolation uses braces, for example: {heading}. Defaults can be supplied in a prop declaration, or a property can be required by omitting its default."

    panel
      title "04 / Design tokens"
      text "Named tokens become CSS custom properties. The same values can be reused across components, while semantic theme colours can reference a colour token."
      grid
        columns 2
        gap "14px"
        panel
          surface "soft"
          title "Colour tokens"
          text "Primary lime, sky blue, violet, and a dark surface are defined in the theme."
          row
            gap "8px"
            badge "Lime"
            badge "Sky"
            badge "Violet"
        panel
          surface "soft"
          title "Radius tokens"
          text "The card token creates a large rounded corner; the pill token represents a fully rounded shape."
          row
            gap "8px"
            badge "Card radius"
              radius "$card"
            badge "Pill radius"
              radius "$pill"
        panel
          surface "soft"
          title "Shadow token"
          text "The soft shadow token is applied to surfaces for consistent depth."
          panel
            surface "glass"
            shadow "$soft"
            title "Token-driven surface"
        card
          surface "soft"
          title "Font and size tokens"
          text "Font-family and type-size tokens can be referenced by supported styled components."
          title "Display-sized example"
            font "$display"
            text-size "$large"
      text "Supported token types: color, radius, shadow, font, and size. Values are validated by type."

    panel
      title "05 / Component variants and tones"
      text "The same base element can be styled with a supported variant, surface, tone, radius, shadow, font, or text size."
      stack
        gap "12px"
        title "Button variants"
        row
          gap "10px"
          wrap true
          button "Primary" -> "#playground"
            variant "primary"
          button "Secondary" -> "#playground"
            variant "secondary"
          button "Quiet" -> "#playground"
            variant "quiet"
          button "Danger" -> "#playground"
            variant "danger"
        divider
        title "Surface variants"
        grid
          columns 2
          gap "12px"
          card
            surface "solid"
            title "Solid"
            text "A firm, high-contrast surface."
          card
            surface "soft"
            title "Soft"
            text "A softer, quieter surface."
          card
            surface "glass"
            title "Glass"
            text "Translucent material styling."
          card
            surface "liquid-glass"
            title "Liquid glass"
            text "Layered glass with visual depth."
        divider
        title "Text tones"
        text "Default tone: clear, high-contrast copy."
        text "Accent tone: colour used to draw attention."
          tone "accent"
        text "Muted tone: secondary information."
          tone "muted"
        text "Danger tone: a warning or destructive-action label."
          tone "danger"
        divider
        title "Card variants"
        grid
          columns 2
          gap "12px"
          card
            variant "featured"
            surface "glass"
            title "Featured card"
            text "Featured styling can emphasise a card or panel."
          card
            surface "soft"
            radius "$card"
            shadow "$soft"
            title "Token-styled card"
            text "Radius and shadow reference theme tokens."

    panel
      title "06 / Materials and ambient effects"
      text "Visual effects are declarative. Hover or scroll to experience the treatments, and use reduced-motion settings to see the accessible fallback."
      grid
        columns 2
        gap "14px"
        card
          surface "glass"
          effect "reflection"
          hover "lift"
          title "Reflection"
          text "A moving highlight sweeps across the surface."
        card
          surface "glass"
          effect "aurora"
          hover "glow"
          title "Aurora"
          text "An ambient coloured glow adds atmosphere."
        card
          surface "glass"
          effect "border-glow"
          hover "scale"
          title "Border glow"
          text "An accent-lit edge gives the card definition."
        card
          surface "liquid-glass"
          effect "none"
          hover "tilt"
          title "Liquid glass, no extra effect"
          text "Materials and effects can be combined or explicitly disabled."
      text "Legacy material "glass" and material "liquid-glass" syntax is also supported."

    panel
      title "07 / Scroll reveals and hover states"
      text "All eight reveal presets and all four hover interactions are represented below. Scroll into this section and hover each card."
      grid
        columns 4
        gap "10px"
        card
          surface "soft"
          animation "fade-up"
          title "fade-up"
          text "Rise into view."
        card
          surface "soft"
          animation "fade-down"
          title "fade-down"
          text "Drop into view."
        card
          surface "soft"
          animation "fade-left"
          title "fade-left"
          text "Enter from the side."
        card
          surface "soft"
          animation "fade-right"
          title "fade-right"
          text "Enter from the other side."
        card
          surface "soft"
          animation "fade"
          title "fade"
          text "Fade in gently."
        card
          surface "soft"
          animation "scale"
          title "scale"
          text "Grow into place."
        card
          surface "soft"
          animation "zoom"
          title "zoom"
          text "Arrive with a deeper zoom."
        card
          surface "soft"
          animation "blur"
          title "blur"
          text "Resolve from a soft blur."
      divider
      grid
        columns 2
        gap "12px"
        card
          surface "soft"
          hover "lift"
          title "Hover: lift"
          text "Moves upward on hover."
        card
          surface "soft"
          hover "glow"
          title "Hover: glow"
          text "Highlights the border and shadow."
        card
          surface "soft"
          hover "scale"
          title "Hover: scale"
          text "Grows slightly on hover."
        card
          surface "soft"
          hover "tilt"
          title "Hover: tilt"
          text "Adds a subtle perspective tilt."
      text "Animation settings support duration, delay, and smooth, spring, snappy, or linear easing. Reveal animations use Intersection Observer. Motion preferences are respected."

    panel
      title "08 / Interactive components"
      text "These are real browser interactions, not static pictures. Try each control."
      stack
        gap "22px"
        panel
          surface "soft"
          title "Accordion"
          text "The first item starts open. Select another item to expand it."
          accordion
            item "What is Forma?"
              text "An indentation-based frontend language that compiles to HTML and CSS."
            item "Are accordions native?"
              text "They use browser details and summary elements."
            item "Does Forma support keyboard access?"
              text "The interactive primitives include focus styling and relevant native or ARIA keyboard behaviour."
        panel
          surface "soft"
          title "Keyboard-navigable tabs"
          text "Use arrow keys, Home, or End while focused on the tab controls."
          tabs
            tab "Overview"
              text "The first panel is selected by default."
            tab "Accessibility"
              text "Tabs use ARIA roles, selected state, and keyboard navigation."
            tab "Implementation"
              text "A small browser runtime switches the selected panel."
        panel
          surface "soft"
          title "Tooltip"
          text "Focus or hover the hint to reveal its supporting text."
          tooltip "What is this?"
            text "Tooltips appear on hover and keyboard focus."
        panel
          surface "soft"
          title "Dropdown menu"
          text "Open the disclosure menu and choose an anchor link."
          dropdown "Open resources"
            option "Language section" -> "#language"
            option "Design section" -> "#design"
            option "Playground" -> "#playground"
        panel
          surface "soft"
          title "Native modal dialog"
          text "Open the dialog, then close it with the close control or Escape."
          modal "Open modal preview"
            badge "NATIVE DIALOG"
            title "A focused moment."
            text "The browser handles dialog focus, Escape to close, and backdrop dismissal."
            divider
            button "Continue exploring" -> "#playground"

    panel
      title "09 / Reactive state"
      text "The little counter below uses declared state, text interpolation, click handlers, and set actions. Press the buttons to update the number."
      card
        surface "glass"
        title "Counter playground"
        text "Current count: {count}"
        row
          gap "10px"
          wrap true
          button "Add one"
            on click
              set count = count + 1
          button "Subtract one"
            variant "secondary"
            on click
              set count = count - 1
          button "Reset count"
            variant "quiet"
            on click
              set count = 0
        divider
        text "Status: {status}"
        row
          gap "10px"
          wrap true
          button "Mark ready"
            variant "secondary"
            on click
              set status = "Ready"
          button "Mark explored"
            variant "secondary"
            on click
              set status = "Explored"
        button "Toggle extra details"
          variant "quiet"
          on click
            set showDetails = true
        when showDetails = true
          panel
            surface "soft"
            title "Conditional content is visible"
            text "This block appears when showDetails is true. Equality conditions support string, number, and boolean values."
      text "State supports numbers, booleans, and strings. Current click actions support numeric addition/subtraction and simple assignments, not arbitrary JavaScript expressions."

    panel
      title "10 / Forms and conditional content"
      text "Try the fields. This demo uses native browser validation, bound input state, a checkbox-driven conditional message, and a client-side success state."
      form "Forma interactive form demo"
        input contactEmail email "Email address"
          placeholder "you@example.com"
          required true
        input displayName text "Name"
          placeholder "Your name"
        input demoPassword password "Password field example"
          placeholder "Not sent anywhere"
        input demoNumber number "Number field example"
          placeholder "42"
        input demoPhone tel "Telephone field example"
          placeholder "+64"
        input demoWebsite url "Website field example"
          placeholder "https://example.com"
        select contactMethod "Preferred contact method"
          option "Email" email
          option "Phone" phone
          option "No preference" any
        textarea messageText "Message"
          placeholder "Write a short message..."
          rows 4
        checkbox wantsUpdates "Send me occasional updates"
        when wantsUpdates = true
          text "You're opted in for the demo preference. This is conditional content driven by checkbox state."
            tone "accent"
        submit "Validate and preview submit"
        success "Success! Native validation passed. This was a client-side demo; no data was sent to a server."
      text "Forms can dispatch a forma:submit event with submitted values. A real application must connect a trusted backend before collecting or storing real user data."

    panel
      title "11 / Navigation, links, and action styles"
      text "Links can use an explicit destination. Buttons can be rendered as actions or link-style navigation, and supported variants apply to the generated element."
      row
        gap "12px"
        wrap true
        link "A regular text link" -> "#language"
        button "Primary link button" -> "#playground"
          variant "primary"
        button "Secondary link button" -> "#design"
          variant "secondary"
      divider
      title "12 / Compiler safety and diagnostics"
      text "The compiler validates many unsupported or malformed values, including component properties, token types, layout values, and animation settings. Parsing errors include line and column information; many semantic errors include line numbers."
      text "Unsafe URL schemes such as javascript:, data:, and vbscript: are rejected. Forma is not a security sandbox for untrusted source code."

    panel
      title "13 / Current boundaries"
      text "Forma is an early-release frontend language. This showcase demonstrates the features implemented today, not features that are only planned."
      grid
        columns 2
        gap "12px"
        card
          title "Available now"
          text "Single-page compilation, reusable components, responsive layouts, design tokens, visual effects, UI primitives, basic state, and client-side forms."
        card
          title "Not built in"
          text "General expressions, loops, full multi-page routing, server-side rendering, databases, authentication, payments, and a package ecosystem."
      text "The output is HTML and CSS plus a small browser runtime. Forms do not connect to a backend automatically."

    panel
      surface "liquid-glass"
      effect "border-glow"
      hover "lift"
      title "Build your first Forma page."
      text "Start with a site, add a page, choose a layout, and layer on only the interactions you need."
      row
        gap "12px"
        wrap true
        button "Back to top" -> "#"
        button "Explore the language" -> "#language"
          variant "secondary"

    footer
      text "FORMA · FEATURE ATLAS · Early-release open-source frontend language. MIT licensed. Built with the features currently implemented in the compiler."
