# Forma 0.2 showcase: materials, motion, responsive layout and design tokens.
site "Forma Studio"
  theme
    background "#09090b"
    foreground "#fafafa"
    accent "#c6f36b"
    muted "#a1a1aa"
    font "Inter"
    token color lime "#c6f36b"
    token color surface "#111318"
    token radius card "22px"
    token shadow soft "0 18px 60px #00000018"
    token font display "Inter"
    accent "$lime"

  component FeatureCard
    prop heading "A thoughtful detail"
    prop description "A reusable component with its own visual treatment."
    card
      surface "glass"
      variant "featured"
      hover "glow"
      radius "$card"
      shadow "$soft"
      animation "fade-up"
        delay "120ms"
        easing smooth
      title "{heading}"
      text "{description}"

  page "/"
    nav
      logo "forma."
      link "Language" -> "#language"
      link "Motion" -> "#motion"
      button "Get started" -> "#start"

    hero
      badge "A new language for the frontend"
      title "Interfaces, with feeling."
      text "Forma brings expressive materials, thoughtful motion, and a clean way to build the web into one small language."
      button "Explore the system" -> "#system"
      button "Read the vision" -> "#language"
        variant "secondary"
        radius "$card"
      animation "fade-up"

    panel
      material "glass"
      animation "zoom"
        duration "700ms"
        easing spring
      hover "lift"
      title "A calmer way to build."
      text "Describe the experience. Forma handles the browser details. This glass surface is generated by the compiler using native CSS effects."

    cards
      FeatureCard
        heading "Forma Motion"
        description "Soft reveals, responsive hover states, and reduced-motion support built into the generated page."
      FeatureCard
        heading "Forma Materials"
        description "Translucent glass, layered surfaces, subtle highlights, and depth without a pile of hand-written CSS."
      FeatureCard
        heading "Forma Style"
        description "A coherent visual foundation with design tokens, responsive layouts, and useful defaults."

    panel
      title "Small syntax. Real output."
      text "Forma compiles to ordinary HTML and CSS today. Next, we will expand the parser, add tests, and build a proper component and interaction model."
      animation "fade-up"

    panel
      title "Made for the moments between clicks."
      text "Interactions are part of the language now, not a separate pile of scripts."
      tabs
        tab "Accordion"
          text "Group answers and details into a calm, collapsible list."
        tab "Tabs"
          text "Switch between related views without leaving the page."
        tab "Dialogs"
          text "Use a native modal for focused actions and details."
      row
        gap "16px"
        align center
        tooltip "A tiny detail"
          text "Tooltips work on hover and keyboard focus."
        dropdown "Explore"
          option "Forma language" -> "#language"
          option "Motion system" -> "#motion"
        modal "Preview a dialog"
          title "A real browser dialog."
          text "Forma now gives interactive components a clear, declarative home."
          button "Got it" -> "#start"
    footer
      text "Forma is an experimental open-source language project. Built for the details."
